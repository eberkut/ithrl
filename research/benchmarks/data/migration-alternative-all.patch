 import re
 
 from .base import BaseAnalyser
+
+
+def has_create_index(sql_statements, **kwargs):
+    identifier = r'("(?:[^"]|"")+"|[^\s(]+)'
+    created_tables = {
+        match.group(1)
+        for statement in sql_statements
+        for match in [re.match(r"\s*CREATE TABLE\s+" + identifier + r"\s*\(", statement)]
+        if match is not None
+    }
+    for statement in sql_statements:
+        if re.search(r"CREATE (UNIQUE )?INDEX\b", statement) and not re.search(
+            r"INDEX CONCURRENTLY\b", statement
+        ):
+            table = re.search(r"\bON\s+" + identifier + r"\s*\(", statement)
+            if table is None or table.group(1) not in created_tables:
+                return True
+    return False
 
 
