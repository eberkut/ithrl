+def has_create_index(sql_statements, **kwargs):
+    identifier = r'("(?:[^"]|"")+"|[^\s(]+)'
+    created_tables = set()
+    for statement in sql_statements:
+        match = re.match(r"\s*CREATE TABLE\s+" + identifier + r"\s*\(", statement)
+        if match:
+            created_tables.add(match.group(1))
+    for statement in sql_statements:
+        if not re.search(r"CREATE (UNIQUE )?INDEX\b", statement):
+            continue
+        if re.search(r"INDEX CONCURRENTLY\b", statement):
+            continue
+        match = re.search(r"\bON\s+" + identifier + r"\s*\(", statement)
+        # Retain the warning when the indexed table cannot be identified.
+        if match is None or match.group(1) not in created_tables:
+            return True
+    return False
 
 
